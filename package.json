{
  "name": "grunge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.engine.config.ts && cp src/engine.ts dist/engine.ts && cp python/grunge.py dist/grunge.py",
    "typecheck": "tsc -p . && tsc -p worker",
    "test": "node --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/alfa-slab-one": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/oswald": "5.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "packageManager": "pnpm@10.29.2"
}
